<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= LIST VIEW ================= -->
    <record id="view_it_ticket_list" model="ir.ui.view">
        <field name="name">it.ticket.list</field>
        <field name="model">it.ticket</field>
        <field name="arch" type="xml">
            <list string="IT Ticket Report" decoration-muted="is_closed">
                <field name="favorite" widget="boolean_favorite" nolabel="1"/>
                <field name="name"/>
                <field name="ticket_type_id"/>
                <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="priority_id"/>
                <field name="stage_id"/>
                <field name="assigned_to" widget="many2one_avatar_user"/>
                <field name="reported_by_id"/>
                <field name="date_opened"/>
                <field name="date_closed"/>
                <field name="resolution_time" readonly="1" sum="Total"/>
                <field name="week_number" readonly="1"/>
                <field name="is_closed" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ================= FORM VIEW ================= -->
    <record id="view_it_ticket_form" model="ir.ui.view">
        <field name="name">it.ticket.form</field>
        <field name="model">it.ticket</field>
        <field name="arch" type="xml">
            <form string="IT Ticket">
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="favorite" widget="boolean_favorite" nolabel="1" class="float-end"/>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">Ticket ID</span>
                        <h1><field name="name" placeholder="e.g. INC-000123 (leave blank if auto-generation is enabled)"/></h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="ticket_type_id" widget="radio" options="{'horizontal': true}"/>
                            <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="priority_id"/>
                        </group>
                        <group string="People">
                            <field name="assigned_to" widget="many2one_avatar_user"/>
                            <field name="reported_by_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dates">
                            <field name="date_opened"/>
                            <field name="date_closed"/>
                        </group>
                        <group string="Auto-calculated (read-only)">
                            <field name="resolution_time" readonly="1"/>
                            <field name="week_number" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Comments">
                            <field name="comments" placeholder="Root cause, follow-up needed, remarks..." nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================= KANBAN VIEW (drag & drop between stages, like Project) === -->
    <record id="view_it_ticket_kanban" model="ir.ui.view">
        <field name="name">it.ticket.kanban</field>
        <field name="model">it.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" quick_create="false">
                <field name="priority_badge_class"/>
                <field name="type_badge_class"/>
                <field name="stage_badge_class"/>
                <field name="stage_id" options="{'group_by_tooltip': {'is_closed': 'Closing stage'}}"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click"
                             t-attf-style="border-top: 3px solid var(--bs-#{record.priority_badge_class.value})">
                            <div class="o_kanban_record_top mb-1">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                                <field name="favorite" widget="boolean_favorite" nolabel="1"/>
                            </div>

                            <div class="o_kanban_record_body" style="font-size: 0.82em; line-height: 1.5;">
                                <div class="mb-1">
                                    <span t-attf-class="badge rounded-pill text-bg-#{record.stage_badge_class.value} me-1">
                                        <field name="stage_id"/>
                                    </span>
                                    <span t-attf-class="badge rounded-pill text-bg-#{record.priority_badge_class.value} me-1">
                                        <field name="priority_id"/>
                                    </span>
                                    <span t-attf-class="badge rounded-pill text-bg-#{record.type_badge_class.value}">
                                        <field name="ticket_type_id"/>
                                    </span>
                                </div>

                                <div class="mb-1">
                                    <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                </div>

                                <div class="text-muted">
                                    <i class="fa fa-user-o me-1"/><field name="reported_by_id"/>
                                    <i class="fa fa-long-arrow-right mx-1"/>
                                    <field name="assigned_to" widget="many2one_avatar_user"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-calendar-o me-1"/>
                                    <field name="date_opened" widget="date"/>
                                    <t t-if="record.date_closed.value"> → <field name="date_closed" widget="date"/></t>
                                    <t t-if="record.resolution_time.value">
                                        <span class="ms-2"><i class="fa fa-hourglass-half me-1"/><field name="resolution_time"/>h</span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================= SEARCH VIEW ================= -->
    <record id="view_it_ticket_search" model="ir.ui.view">
        <field name="name">it.ticket.search</field>
        <field name="model">it.ticket</field>
        <field name="arch" type="xml">
            <search string="Search IT Tickets">
                <field name="name"/>
                <field name="reported_by_id"/>
                <field name="assigned_to"/>
                <field name="category_ids"/>
                <field name="comments"/>
                <filter string="My Tickets" name="my_tickets" domain="[('assigned_to','=',uid)]"/>
                <filter string="My Favorites" name="my_favorites" domain="[('favorite','=',True)]"/>
                <filter string="Open" name="open" domain="[('is_closed','=',False)]"/>
                <filter string="Closed" name="closed" domain="[('is_closed','=',True)]"/>
                <separator/>
                <filter string="Date Opened" name="filter_date_opened" date="date_opened"/>
                <group expand="0" string="Group By">
                    <filter string="Week #" name="group_week" context="{'group_by':'week_number'}"/>
                    <filter string="Stage" name="group_stage" context="{'group_by':'stage_id'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by':'priority_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by':'category_ids'}"/>
                    <filter string="Assigned To" name="group_assigned" context="{'group_by':'assigned_to'}"/>
                    <filter string="Type" name="group_type" context="{'group_by':'ticket_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================= PIVOT VIEW (weekly consolidated report) ================= -->
    <record id="view_it_ticket_pivot" model="ir.ui.view">
        <field name="name">it.ticket.pivot</field>
        <field name="model">it.ticket</field>
        <field name="arch" type="xml">
            <pivot string="IT Ticket Report - Consolidated">
                <field name="week_number" type="row"/>
                <field name="assigned_to" type="row"/>
                <field name="stage_id" type="col"/>
                <field name="resolution_time" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ================= GRAPH VIEW ================= -->
    <record id="view_it_ticket_graph" model="ir.ui.view">
        <field name="name">it.ticket.graph</field>
        <field name="model">it.ticket</field>
        <field name="arch" type="xml">
            <graph string="Tickets by Week" type="bar">
                <field name="week_number" type="row"/>
                <field name="priority_id" type="col"/>
            </graph>
        </field>
    </record>

    <!-- ================= ACTION ================= -->
    <record id="action_it_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">it.ticket</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_it_ticket_search"/>
        <field name="context">{'search_default_my_tickets': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first IT ticket
            </p>
            <p>
                Every task must be linked to a Ticket ID before work starts.
                This replaces the weekly Excel report: Resolution Time and Week #
                are calculated automatically.
            </p>
        </field>
    </record>

    <!-- ================= REPORTING ACTION (pivot/graph, for All & Admin) ================= -->
    <record id="action_it_ticket_reporting" model="ir.actions.act_window">
        <field name="name">Reporting</field>
        <field name="res_model">it.ticket</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="view_it_ticket_search"/>
    </record>

</odoo>
