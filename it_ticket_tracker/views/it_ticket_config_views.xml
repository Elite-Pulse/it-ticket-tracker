<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= STAGES ================= -->
    <record id="view_it_ticket_stage_list" model="ir.ui.view">
        <field name="name">it.ticket.stage.list</field>
        <field name="model">it.ticket.stage</field>
        <field name="arch" type="xml">
            <list string="Ticket Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="fold"/>
                <field name="is_closed"/>
            </list>
        </field>
    </record>
    <record id="action_it_ticket_stage" model="ir.actions.act_window">
        <field name="name">Ticket Stages</field>
        <field name="res_model">it.ticket.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first ticket stage</p>
            <p>Stages appear as columns on the Kanban board. You can also add, rename,
               reorder (drag) or delete them directly from the Kanban board.
               Tick "Closing Stage" so Resolution Time / Week # count correctly.</p>
        </field>
    </record>

    <!-- ================= TYPES ================= -->
    <record id="view_it_ticket_type_list" model="ir.ui.view">
        <field name="name">it.ticket.type.list</field>
        <field name="model">it.ticket.type</field>
        <field name="arch" type="xml">
            <list string="Ticket Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
    <record id="action_it_ticket_type" model="ir.actions.act_window">
        <field name="name">Ticket Types</field>
        <field name="res_model">it.ticket.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================= CATEGORIES ================= -->
    <record id="view_it_ticket_category_list" model="ir.ui.view">
        <field name="name">it.ticket.category.list</field>
        <field name="model">it.ticket.category</field>
        <field name="arch" type="xml">
            <list string="Ticket Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
    <record id="action_it_ticket_category" model="ir.actions.act_window">
        <field name="name">Ticket Categories</field>
        <field name="res_model">it.ticket.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================= PRIORITIES ================= -->
    <record id="view_it_ticket_priority_list" model="ir.ui.view">
        <field name="name">it.ticket.priority.list</field>
        <field name="model">it.ticket.priority</field>
        <field name="arch" type="xml">
            <list string="Ticket Priorities" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
    <record id="action_it_ticket_priority" model="ir.actions.act_window">
        <field name="name">Ticket Priorities</field>
        <field name="res_model">it.ticket.priority</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>The color you pick here is used for the Kanban card's color band.</p>
        </field>
    </record>

    <!-- ================= REPORTERS ================= -->
    <record id="view_it_ticket_reporter_list" model="ir.ui.view">
        <field name="name">it.ticket.reporter.list</field>
        <field name="model">it.ticket.reporter</field>
        <field name="arch" type="xml">
            <list string="Reporters / Requesters" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="action_it_ticket_reporter" model="ir.actions.act_window">
        <field name="name">Reporters / Requesters</field>
        <field name="res_model">it.ticket.reporter</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>This list grows automatically whenever a user types a new name on a
               ticket's "Reported By" field and confirms "Create ...". It is local
               to this module only - it never touches Employees or Contacts.</p>
        </field>
    </record>
    <record id="action_it_ticket_reporter_import_users" model="ir.actions.server">
        <field name="name">Import current Users</field>
        <field name="model_id" ref="model_it_ticket_reporter"/>
        <field name="binding_model_id" ref="model_it_ticket_reporter"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = model.action_import_users()</field>
    </record>

    <!-- ================= SETTINGS ================= -->
    <record id="view_it_ticket_settings_form" model="ir.ui.view">
        <field name="name">it.ticket.settings.form</field>
        <field name="model">it.ticket.settings</field>
        <field name="arch" type="xml">
            <form string="IT Ticket Tracker Settings">
                <sheet>
                    <h2>Ticket ID</h2>
                    <group>
                        <field name="auto_generate_id"/>
                        <field name="id_prefix" invisible="not auto_generate_id"/>
                    </group>
                    <p class="text-muted" style="text-align: justify;">
                        When off (default, matches normale process), the Ticket ID must be
                        pasted in from the external ticketing tool - tickets without one are
                        blocked from saving. When on, leaving the Ticket ID blank on a new
                        ticket auto-fills one using the prefix above (e.g. TCK-000123).
                    </p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_it_ticket_config_settings" model="ir.actions.act_window">
        <field name="name">IT Ticket Settings</field>
        <field name="res_model">it.ticket.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="res_id" ref="it_ticket_settings_singleton"/>
    </record>

</odoo>
