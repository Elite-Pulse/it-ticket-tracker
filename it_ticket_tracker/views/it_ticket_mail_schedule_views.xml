<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= SCHEDULE ================= -->
    <record id="view_it_ticket_mail_schedule_list" model="ir.ui.view">
        <field name="name">it.ticket.mail.schedule.list</field>
        <field name="model">it.ticket.mail.schedule</field>
        <field name="arch" type="xml">
            <list string="Auto-Mailing Schedules">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="subject"/>
                <field name="partner_ids" widget="many2many_tags"/>
                <field name="send_daily" string="Daily"/>
                <field name="send_weekly" string="Weekly"/>
                <field name="send_biweekly" string="2-Weekly"/>
                <field name="send_monthly" string="Monthly"/>
                <field name="send_yearly" string="Yearly"/>
            </list>
        </field>
    </record>

    <record id="view_it_ticket_mail_schedule_form" model="ir.ui.view">
        <field name="name">it.ticket.mail.schedule.form</field>
        <field name="model">it.ticket.mail.schedule</field>
        <field name="arch" type="xml">
            <form string="Auto-Mailing Schedule">
                <header>
                    <button name="action_send_now" type="object" string="Send Now" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="log_count" widget="statinfo" string="Sent"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Enabled">
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <group string="Recipients">
                            <field name="partner_ids" widget="many2many_tags"/>
                            <field name="partner_cc_ids" widget="many2many_tags"/>
                            <field name="subject"/>
                        </group>
                        <group string="What to include">
                            <field name="stage_ids" widget="many2many_tags"/>
                            <field name="assigned_to_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Send frequency (tick one or more)">
                        <group>
                            <field name="send_daily"/>
                            <field name="send_weekly"/>
                            <field name="send_biweekly"/>
                        </group>
                        <group>
                            <field name="send_monthly"/>
                            <field name="send_yearly"/>
                        </group>
                    </group>
                    <group string="Last run per frequency" col="4">
                        <field name="last_run_daily"/>
                        <field name="last_run_weekly"/>
                        <field name="last_run_biweekly"/>
                        <field name="last_run_monthly"/>
                        <field name="last_run_yearly"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_it_ticket_mail_schedule" model="ir.actions.act_window">
        <field name="name">Auto Mailing</field>
        <field name="res_model">it.ticket.mail.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up an auto-mailing schedule</p>
            <p>Send the IT Ticket report (PDF + Excel) automatically to whoever needs it,
               on a daily, weekly, bi-weekly, monthly or yearly cycle. SMTP must already
               be configured in Settings (it already is here).</p>
        </field>
    </record>

    <!-- ================= HISTORY (read-only, admin) ================= -->
    <record id="view_it_ticket_mail_log_list" model="ir.ui.view">
        <field name="name">it.ticket.mail.log.list</field>
        <field name="model">it.ticket.mail.log</field>
        <field name="arch" type="xml">
            <list string="Auto-Mailing History" create="false" edit="false" delete="false"
                  decoration-danger="not success">
                <field name="run_date"/>
                <field name="schedule_id"/>
                <field name="frequency"/>
                <field name="ticket_count"/>
                <field name="success" widget="boolean_toggle"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_it_ticket_mail_log" model="ir.actions.act_window">
        <field name="name">Mailing History</field>
        <field name="res_model">it.ticket.mail.log</field>
        <field name="view_mode">list</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p>Every scheduled or manual send attempt is logged here, whether it
               succeeded or failed, so you always know what was sent and when.</p>
        </field>
    </record>

</odoo>
